# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Search-console ownership proofs (Search Console → Settings → Verification,
# Bing Webmaster Tools → Add site): the meta tags render only when set.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Supabase hosted project
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key
# The URL above plus these keys are also what `npm run types:db` (A6) uses to
# regenerate lib/supabase/database.types.ts and what `npm run verify:types`
# checks in CI. The service key is required because the PostgREST OpenAPI root
# rejects the publishable key.

# Cloudflare R2: public photo storage
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=your-r2-bucket
R2_PUBLIC_BASE_URL=https://media.example.com
# Client-side mirror of the R2 public base URL. The server accepts either this
# variable or R2_PUBLIC_BASE_URL; keep their hosts in sync when both are set.
NEXT_PUBLIC_R2_PUBLIC_BASE_URL=https://media.example.com

# Backblaze B2: backup mirror
B2_ENDPOINT=https://s3.your-region.backblazeb2.com
B2_KEY_ID=your-b2-key-id
B2_APPLICATION_KEY=your-b2-application-key
B2_BACKUP_BUCKET=your-b2-backup-bucket

# Supabase Storage: admin assets
SUPABASE_ADMIN_ASSET_BUCKET=admin-asset

# Optional Cloudinary transform layer
CLOUDINARY_CLOUD_NAME=

# French translation of imported articles (scripts/fill-fr.mjs). Free keys end
# in ":fx" → the free endpoint is used automatically; the free tier allows
# ~500k chars/month (the script budgets 450k per run and resumes on re-runs).
DEEPL_API_KEY=

# Editorial model — powers the intelligence layer on top of DeepL.
# PREFERRED: set the key in Admin → Secrets → AI provider (validated live,
# encrypted in the vault, no redeploy; vault wins over these env values).
# Env fallback below for headless/CI deploys. Without either, the layer is
# inert and every path falls back to DeepL + offline heuristics.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# Vision model for alt-text / creative QA (falls back to LLM_MODEL).
LLM_VISION_MODEL=
# Embedding model for the P5 memory layer (must stay 1536-dim; changing it
# requires re-embedding — see supabase/migrations/20261115000000_*).
LLM_EMBED_MODEL=text-embedding-3-small
# Daily token budget across all AI actions (server-enforced, best-effort log
# in llm_calls). Editors see usage in the AI status badge.
LLM_BUDGET_TOKENS_DAY=200000
# Kill-switch: =1 forces offline smart fill even with a key set.
LLM_DISABLED=

# Optional error tracking (lib/observability/logger.ts forwards warn/error
# events when a Sentry SDK is installed). Nothing to install to use — see docs/observability.md
SENTRY_DSN=
# Optional nightly ops-digest webhook (Discord/Slack-compatible JSON POST).
# When set, /api/cron/ops-digest posts the queue summary; see docs/observability.md
DIGEST_WEBHOOK_URL=

# Cron jobs: bearer secret guarding /api/cron/* (fail-closed —
# required on the host; see lib/security/cron-auth.ts)
CRON_SECRET=
# Local-drill opt-in ONLY: =1 allows /api/cron/* without CRON_SECRET outside
# production. Never set in production — unset fails closed (500 prod / 401 dev).
ALLOW_UNAUTH_CRON=
# Direct Postgres URL for pg_dump (db-dump cron only, server-only)
SUPABASE_DB_URL=
# Audit retention for the nightly db-maintenance sweep: audit_events rows
# older than this many days are hard-deleted (30–3650, default 365).
# Completed storage_tasks are always purged after 30 days.
AUDIT_RETENTION_DAYS=365
# Tamper-evident audit hash chain: HMAC key sealing each audit_events row to
# its predecessor (any string; falls back to CREDENTIAL_ENCRYPTION_KEY).
# Verifies on the audit page + monthly archive cron.
AUDIT_CHAIN_KEY=
# Optional storage capacity guardrail in bytes (e.g. the R2 plan allowance).
# Shown on the storage tab; the nightly backup job alerts past 80% usage.
STORAGE_QUOTA_BYTES=

# Notifications: per-event email via SMTP (staff custom SMTP — same host as
# the Supabase custom SMTP). Unset = email channel reports "not configured"
# and the notify worker delivers in-app only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Eagle Eye Africa <no-reply@eagleeyeafrica.org>

# Notifications: WhatsApp via Meta Cloud API (highest open rates — the
# primary staff-alert channel once set). Unset = WhatsApp reports
# "not configured"; the admin queue offers wa.me manual links instead.
# Create: developers.facebook.com → WhatsApp app → API Setup (test number),
# then request production + a utility template for out-of-window sends.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Optional approved utility template for proactive out-of-window sends
# (nightly digest fan-out + 24h-window fallback in the notify worker).
# Must be a body-only `utility` template with a single {{1}} text parameter;
# exact EN + FR bodies to submit live in docs/whatsapp-template.md.
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en
# Optional French twin of the above (falls back to WHATSAPP_TEMPLATE when
# unset — French recipients then get the base template language).
WHATSAPP_TEMPLATE_FR=
WHATSAPP_TEMPLATE_FR_LANG=fr

# Abusive-traffic identity: number of trusted reverse proxies in front of the
# app. Rate-limit keys take the client address relative to this depth, so a
# client-forged x-forwarded-for prefix is ignored. 1 = one proxy/CDN terminator
# (default, correct for the Hostinger deployment whether the proxy appends or
# overwrites the header). Set to 0 only if the app is reached directly, in which
# case forwarded headers are unattributable and all traffic shares one bucket.
TRUSTED_PROXY_COUNT=1

# Readiness endpoint (/api/ready): public callers get status + correlation id
# only; the detailed dependency report (missing env names, driver errors)
# requires this DEDICATED bearer secret. Phase 0: no fallback to CRON_SECRET.
# Leave unset to disable detailed output entirely.
READY_PROBE_SECRET=

# Secret management (admin → Credentials): AES-256-GCM key that encrypts every
# stored API credential at rest (spec §16). 32 bytes as base64 (44 chars) or
# hex (64 chars); generate once with `openssl rand -base64 32`. Server-only —
# rotating it makes existing ciphertext undecryptable, and while unset the
# credentials screens degrade (nothing can be stored or read).
CREDENTIAL_ENCRYPTION_KEY=

# Observability + versioning (read by lib/observability/logger.ts, sentry.*.config.ts, /api/health)
NEXT_PUBLIC_SENTRY_DSN=
LOG_LEVEL=
APP_VERSION=

# Auth providers allowlist (comma-separated, e.g. "google,github")
NEXT_PUBLIC_OAUTH_PROVIDERS=

# CSP hardening knobs (lib/security/csp.ts → next.config.ts headers)
CSP_EXTRA_IMAGE_HOSTS=
CSP_EXTRA_CONNECT_HOSTS=
# Extra hosts a third-party ad tag needs beyond what NEXT_PUBLIC_AD_SLOTS implies
# (e.g. a creative CDN). Added to script/frame/img/connect-src; the browser
# console names any host that is still blocked.
CSP_AD_EXTRA_HOSTS=
CSP_ALLOW_ANY_IMAGE_HOST=
CSP_REPORT_URI=

# Human verification on public intake (submissions, reports, corrections,
# digest, contact, data-request, takedown, advertise, signup/login/reset).
#
# Modes (NEXT_PUBLIC_HUMAN_MODE, client-visible — rebuild required to change):
#   unset / pow  (default) signed proof-of-work challenge issued by a server
#                action and solved locally with WebCrypto. Zero third-party
#                requests, so a slow/metered link never waits on a CDN and a
#                content blocker cannot wall the form off. See
#                lib/security/pow.ts + lib/security/pow-solve.ts.
#   turnstile    the Cloudflare widget (rollback lever — one high-risk weekend
#                without a code change). Requires both Turnstile keys below;
#                it also re-allows the Cloudflare origins in the CSP.
#   off          dev/tests only. IGNORED in production: the gate always
#                resolves to a verifying mode there.
NEXT_PUBLIC_HUMAN_MODE=
# Optional dedicated HMAC key for the PoW challenge (openssl rand -hex 32).
# Unset = derived from SUPABASE_SERVICE_ROLE_KEY, which is server-only, so no
# new secret must be provisioned for the gate to be live.
POW_HMAC_KEY=
# Leading-zero-bits difficulty. Default 16 (≈65k digests, ~0.5–2s on a mid
# phone); clamped to 8–24 so a bad value can neither trivialize nor wreck it.
POW_DIFFICULTY_BITS=
# Local-only rehearsal: =1 forces the production fail-closed PoW posture in dev.
POW_REQUIRE=

# Cloudflare Turnstile — kept for NEXT_PUBLIC_HUMAN_MODE=turnstile (rollback).
# Not consulted in the default pow mode. Fail-closed in production: when the
# secret is unset, verifyTurnstileToken returns false in production (true in
# dev for local convenience; set TURNSTILE_REQUIRE=1 to rehearse production).
# Anon INSERT policies are deliberately permissive, so this remains a launch
# blocker whenever the deployment runs the widget.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Local-only: =1 forces production fail-closed Turnstile in dev.
TURNSTILE_REQUIRE=

# ─────────────────────────────────────────────────────────────────────────────
# Remnant advertising (third-party ad networks) — see docs/ad-monetization.md
#
# LIVE CONFIG LIVES IN THE DATABASE: /admin/ads → Networks writes
# `ad_slots.network_*` and the single `ad_network_settings` row, and
# lib/queries/ad-networks.ts serves them to the public tree (cached, `ads` tag).
# A change there is live on the next public render — no rebuild.
#
# The NEXT_PUBLIC_AD_* variables below are the BOOTSTRAP/FALLBACK: they are used
# when the database has no network rows (fresh install, migration not applied,
# local dev without a DB). They are baked at build time, so editing one needs a
# rebuild; prefer the admin screen. Each is public information (it ships in the
# HTML) — never put a network API key or reporting secret here.
#
# NEXT_PUBLIC_AD_SLOTS — optional JSON, one entry per placement key. Placement
# keys are listed in lib/ads/networks.ts (AD_PLACEMENTS). Fields:
#   format      banner | native | in-page-push | push | interstitial | vignette |
#               popunder | smartlink | adsense
#   url         https tag URL copied from the network dashboard (required,
#               except for adsense which defaults to the official loader)
#   network     free-form label used in reporting/debugging
#   width/height  reserved box in CSS px (boxed formats only; 50–1200 tall)
#   attributes  object of data-* attributes the network asks for
#   adsense     { "client": "ca-pub-…", "adSlot": "…" } for Google AdSense
NEXT_PUBLIC_AD_SLOTS=
# Fallback kill switch: `0` disables every network unit.
NEXT_PUBLIC_ADS_ENABLED=
# Fallback consent gate (default ON): no network script loads until the reader
# accepts the cookie banner.
NEXT_PUBLIC_AD_CONSENT_REQUIRED=
# Fallback reserve-space mode (default ON, i.e. leave this unset): the box keeps
# its space from the first paint and shows the house card until the tag paints.
# Set `0` only to go back to "render nothing until consent".
NEXT_PUBLIC_AD_RESERVE_SPACE=
# Fallback house-ad switch (default ON): an unfilled placement renders the
# site's own "Advertise with us" card instead of disappearing.
NEXT_PUBLIC_AD_HOUSE_ADS=
# ads.txt records, one per line (a literal \n also works). Copy each line
# verbatim from the network dashboard. app/ads.txt/route.ts validates them and
# drops anything that is not `domain, account, DIRECT|RESELLER`. Request-time,
# so no rebuild is needed when a record changes.
ADS_TXT_LINES=
