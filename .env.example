# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase hosted project
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key
# The URL above plus these keys are also what `npm run types:db` (A6) uses to
# regenerate lib/supabase/database.types.ts and what `npm run verify:types`
# checks in CI. The service key is required because the PostgREST OpenAPI root
# rejects the publishable key.

# Cloudflare R2: public photo storage
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=your-r2-bucket
R2_PUBLIC_BASE_URL=https://media.example.com
# Client-side mirror of the R2 public base URL: lets next/image + SmartImage
# optimize R2 media in the browser bundle (must match R2_PUBLIC_BASE_URL host)
NEXT_PUBLIC_R2_PUBLIC_BASE_URL=https://media.example.com

# Backblaze B2: backup mirror
B2_ENDPOINT=https://s3.your-region.backblazeb2.com
B2_KEY_ID=your-b2-key-id
B2_APPLICATION_KEY=your-b2-application-key
B2_BACKUP_BUCKET=your-b2-backup-bucket

# Supabase Storage: admin assets
SUPABASE_ADMIN_ASSET_BUCKET=admin-asset

# Optional Cloudinary transform layer
CLOUDINARY_CLOUD_NAME=

# French translation of imported articles (scripts/fill-fr.mjs). Free keys end
# in ":fx" → the free endpoint is used automatically; the free tier allows
# ~500k chars/month (the script budgets 450k per run and resumes on re-runs).
DEEPL_API_KEY=

# Optional error tracking (lib/observability/logger.ts forwards warn/error
# events when a Sentry SDK is installed). Nothing to install to use — see docs/observability.md
SENTRY_DSN=
# Optional nightly ops-digest webhook (Discord/Slack-compatible JSON POST).
# When set, /api/cron/ops-digest posts the queue summary; see docs/observability.md
DIGEST_WEBHOOK_URL=

# Cron jobs: bearer secret guarding /api/cron/* (fail-closed —
# required on the host; see lib/security/cron-auth.ts)
CRON_SECRET=
# Local-drill opt-in ONLY: =1 allows /api/cron/* without CRON_SECRET outside
# production. Never set in production — unset fails closed (500 prod / 401 dev).
ALLOW_UNAUTH_CRON=
# Direct Postgres URL for pg_dump (db-dump cron only, server-only)
SUPABASE_DB_URL=

# Notifications: per-event email via SMTP (staff custom SMTP — same host as
# the Supabase custom SMTP). Unset = email channel reports "not configured"
# and the notify worker delivers in-app only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Eagle Eye Africa <no-reply@eagleeyeafrica.org>

# Notifications: WhatsApp via Meta Cloud API (highest open rates — the
# primary staff-alert channel once set). Unset = WhatsApp reports
# "not configured"; the admin queue offers wa.me manual links instead.
# Create: developers.facebook.com → WhatsApp app → API Setup (test number),
# then request production + a utility template for out-of-window sends.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Optional approved utility template for proactive out-of-window sends
# (nightly digest fan-out + 24h-window fallback in the notify worker).
# Must be a body-only `utility` template with a single {{1}} text parameter;
# exact EN + FR bodies to submit live in docs/whatsapp-template.md.
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en
# Optional French twin of the above (falls back to WHATSAPP_TEMPLATE when
# unset — French recipients then get the base template language).
WHATSAPP_TEMPLATE_FR=
WHATSAPP_TEMPLATE_FR_LANG=fr

# Abusive-traffic identity: number of trusted reverse proxies in front of the
# app. Rate-limit keys take the client address relative to this depth, so a
# client-forged x-forwarded-for prefix is ignored. 1 = one proxy/CDN terminator
# (default, correct for the Hostinger deployment whether the proxy appends or
# overwrites the header). Set to 0 only if the app is reached directly, in which
# case forwarded headers are unattributable and all traffic shares one bucket.
TRUSTED_PROXY_COUNT=1

# Readiness endpoint (/api/ready): public callers get status + correlation id
# only; the detailed dependency report (missing env names, driver errors)
# requires this DEDICATED bearer secret. Phase 0: no fallback to CRON_SECRET.
# Leave unset to disable detailed output entirely.
READY_PROBE_SECRET=

# Observability + versioning (read by lib/observability/logger.ts, sentry.*.config.ts, /api/health)
NEXT_PUBLIC_SENTRY_DSN=
LOG_LEVEL=
APP_VERSION=

# Auth providers allowlist (comma-separated, e.g. "google,github")
NEXT_PUBLIC_OAUTH_PROVIDERS=

# CSP hardening knobs (lib/security/csp.ts → next.config.ts headers)
CSP_EXTRA_IMAGE_HOSTS=
CSP_EXTRA_CONNECT_HOSTS=
CSP_ALLOW_ANY_IMAGE_HOST=
CSP_REPORT_URI=

# Cloudflare Turnstile (bot protection on anon intake: submissions, digest,
# contact, takedown, reports). Fail-closed in production: when the secret is
# unset, verifyTurnstileToken returns false in production (true in dev for
# local convenience; set TURNSTILE_REQUIRE=1 to rehearse production). Anon
# INSERT policies are deliberately permissive, so this is a launch blocker —
# set BOTH keys before go-live.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
