# Install as /etc/nginx/sites-available/eagleeyeafrica.org
# Enable with:
#   ln -s /etc/nginx/sites-available/eagleeyeafrica.org /etc/nginx/sites-enabled/eagleeyeafrica.org
# Obtain TLS only after DNS resolves:
#   certbot --nginx -d eagleeyeafrica.org -d www.eagleeyeafrica.org

upstream eea_next {
    server 127.0.0.1:3000;
    keepalive 32;
}

server {
    listen 80;
    listen [::]:80;
    server_name eagleeyeafrica.org www.eagleeyeafrica.org;

    client_max_body_size 20m;

    location / {
        proxy_pass http://eea_next;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
